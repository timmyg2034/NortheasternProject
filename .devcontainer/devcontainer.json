{
  "name": "Python 3 & Node.js",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "backend/main.py",
        "frontend/src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; npm --prefix frontend ci; echo 'Requirements and frontend packages installed'",
  "postAttachCommand": {
    "server": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Vite Frontend",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
